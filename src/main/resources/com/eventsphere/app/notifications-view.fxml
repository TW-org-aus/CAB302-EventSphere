<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eventsphere.app.NotificationsController"
      stylesheets="@app.css">
    <children>
        <fx:include source="nav-bar.fxml"/>
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
    <content>
        <VBox styleClass="page-bg" alignment="TOP_CENTER" spacing="24">
            <padding>
                <Insets top="40.0" bottom="80.0" left="32.0" right="32.0"/>
            </padding>

            <VBox styleClass="card" maxWidth="700" spacing="0">
                <Label text="Notifications" styleClass="card-title"/>

                <VBox spacing="0" style="-fx-padding: 18 0 0 0;">
                    <VBox styleClass="event-row" spacing="4">
                        <Label text="New reply to your comment" styleClass="body-text"/>
                        <Label text="Jordan Lee replied: &quot;See you there!&quot; on Warehouse night: local DJs" styleClass="muted-text" wrapText="true"/>
                        <Label text="2 hours ago" styleClass="muted-text"/>
                    </VBox>
                    <VBox styleClass="event-row" spacing="4">
                        <Label text="New message" styleClass="body-text"/>
                        <Label text="Jordan Lee sent you a new message" styleClass="muted-text" wrapText="true"/>
                        <Label text="5 hours ago" styleClass="muted-text"/>
                    </VBox>
                    <VBox styleClass="event-row" spacing="4">
                        <Label text="Event reminder" styleClass="body-text"/>
                        <Label text="Sunrise 5k along the river starts tomorrow at 06:00" styleClass="muted-text" wrapText="true"/>
                        <Label text="1 day ago" styleClass="muted-text"/>
                    </VBox>
                </VBox>
            </VBox>
        </VBox>
    </content>
        </ScrollPane>
    </children>
</VBox>
