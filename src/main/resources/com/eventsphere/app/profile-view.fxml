<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eventsphere.app.ProfileController"
      stylesheets="@app.css">
    <children>
        <fx:include source="nav-bar.fxml"/>
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox styleClass="page-bg" alignment="TOP_CENTER" spacing="24">
                    <padding>
                        <Insets top="40.0" bottom="80.0" left="32.0" right="32.0"/>
                    </padding>

                    <!-- Profile card -->
                    <VBox styleClass="card" maxWidth="1000" spacing="18">
                        <HBox spacing="18" alignment="TOP_LEFT">
                            <Label fx:id="avatarLabel" text="AC" styleClass="avatar"/>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label fx:id="nameLabel" text="Ava Chen" styleClass="card-title"/>
                                <Label fx:id="subtitleLabel" text="West End · 27" styleClass="muted-text"/>
                            </VBox>
                            <Button fx:id="editButton" text="Edit" styleClass="secondary-button" onAction="#onEditProfileClick"/>
                            <Button text="Settings" styleClass="primary-button" onAction="#onSettingsClick"/>
                        </HBox>

                        <Label fx:id="bioLabel" styleClass="body-text" wrapText="true"/>

                        <HBox spacing="32">
                            <VBox>
                                <Label fx:id="friendsCount" text="0" styleClass="stat-num"/>
                                <Label text="Friends" styleClass="stat-label"/>
                            </VBox>
                            <VBox>
                                <Label fx:id="goingCount" text="0" styleClass="stat-num"/>
                                <Label text="Joined" styleClass="stat-label"/>
                            </VBox>
                        </HBox>

                        <HBox fx:id="interestBox" spacing="10"/>
                    </VBox>

                    <!-- Events card -->
                    <VBox styleClass="card" maxWidth="1000" spacing="0">
                        <HBox spacing="10">
                            <Button fx:id="goingTab" text="Going" styleClass="tab-pill, tab-pill-active" onAction="#onGoingTabClick"/>
                            <Button fx:id="beenTab" text="Been" styleClass="tab-pill" onAction="#onBeenTabClick"/>
                        </HBox>

                        <VBox fx:id="eventList" spacing="0" style="-fx-padding: 18 0 0 0;"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>