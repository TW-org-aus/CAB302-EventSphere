<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox alignment="CENTER_LEFT" prefHeight="72.0" spacing="16.0" style="-fx-background-color: #0B0B0B;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eventsphere.app.NavBarController">
    <children>
        <Button text="EVENTSPHERE" onAction="#onLogoClick"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-cursor: hand;">
            <HBox.margin>
                <Insets left="24.0"/>
            </HBox.margin>
        </Button>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="709.0" pickOnBounds="false"
              prefHeight="41.0" prefWidth="647.0" spacing="8.0"
              style="-fx-background-color: white; -fx-background-radius: 21; -fx-padding: 0 16 0 16;">
            <children>
                <FontIcon iconLiteral="bi-search" iconSize="15" iconColor="#6B7280"/>
                <TextField fx:id="searchField" promptText="Search events, hosts, locations..."
                           style="-fx-background-color: transparent; -fx-border-color: transparent;"
                           onAction="#onSearch" HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="14.0">
            <children>
                <StackPane alignment="CENTER" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0"
                           prefHeight="38.0" prefWidth="38.0"
                           style="-fx-background-color: white; -fx-background-radius: 50px; -fx-cursor: hand;"
                           onMouseClicked="#onNotificationsClick">
                    <children>
                        <FontIcon iconLiteral="bi-bell" iconSize="16" iconColor="#111111"/>
                    </children>
                </StackPane>
                <StackPane alignment="CENTER" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0"
                           prefHeight="38.0" prefWidth="38.0"
                           style="-fx-background-color: white; -fx-background-radius: 50px; -fx-cursor: hand;"
                           onMouseClicked="#onMessagesClick">
                    <children>
                        <FontIcon iconLiteral="bi-chat-dots" iconSize="16" iconColor="#111111"/>
                    </children>
                </StackPane>
                <StackPane alignment="CENTER" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0"
                           prefHeight="38.0" prefWidth="38.0"
                           style="-fx-background-color: #2E6BE8; -fx-background-radius: 50px; -fx-cursor: hand;"
                           onMouseClicked="#onProfileClick">
                    <children>
                        <FontIcon iconLiteral="bi-person-fill" iconSize="16" iconColor="white"/>
                    </children>
                </StackPane>
                <!-- Temporary dev-only entry point until real auth/session state exists; remove once login is reachable another way -->
                <Button text="Log In" onAction="#onLoginClick"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-underline: true; -fx-cursor: hand;"/>
            </children>
            <HBox.margin>
                <Insets right="24.0"/>
            </HBox.margin>
        </HBox>
    </children>
</HBox>
