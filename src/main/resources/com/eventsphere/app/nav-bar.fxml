<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="72.0" styleClass="nav-bg"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.eventsphere.app.NavBarController">
    <children>
        <HBox alignment="CENTER_LEFT" pickOnBounds="false">
            <children>
                <Button fx:id="brandButton" onAction="#onLogoClick" styleClass="brand-button"
                        accessibleText="EventSphere, go to home">
                    <graphic>
                        <ImageView fitHeight="48.0" preserveRatio="true" smooth="true">
                            <image><Image url="@logo/logo.png"/></image>
                        </ImageView>
                    </graphic>
                    <HBox.margin><Insets left="24.0"/></HBox.margin>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="14.0">
                    <children>
                        <StackPane fx:id="notificationsButton" alignment="CENTER" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0"
                                   prefHeight="38.0" prefWidth="38.0"
                                   style="-fx-background-color: -white; -fx-background-radius: 50px; -fx-cursor: hand;"
                                   onMouseClicked="#onNotificationsClick">
                            <children>
                                <FontIcon iconLiteral="bi-bell" iconSize="16" styleClass="icon-text"/>
                            </children>
                        </StackPane>
                        <StackPane fx:id="messagesButton" alignment="CENTER" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0"
                                   prefHeight="38.0" prefWidth="38.0"
                                   style="-fx-background-color: -white; -fx-background-radius: 50px; -fx-cursor: hand;"
                                   onMouseClicked="#onMessagesClick">
                            <children>
                                <FontIcon iconLiteral="bi-chat-dots" iconSize="16" styleClass="icon-text"/>
                            </children>
                        </StackPane>
                        <StackPane fx:id="profileButton" alignment="CENTER" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0"
                                   prefHeight="38.0" prefWidth="38.0"
                                   style="-fx-background-color: -highlight; -fx-background-radius: 50px; -fx-cursor: hand;"
                                   onMouseClicked="#onProfileClick">
                            <children>
                                <FontIcon iconLiteral="bi-person-fill" iconSize="16" styleClass="icon-white"/>
                            </children>
                        </StackPane>
                        <Button fx:id="authButton" onAction="#onAuthClick"
                                style="-fx-background-color: transparent; -fx-text-fill: -on-dark; -fx-underline: true; -fx-cursor: hand;"/>
                    </children>
                    <HBox.margin><Insets right="24.0"/></HBox.margin>
                </HBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" maxHeight="41.0" maxWidth="647.0"
              prefHeight="41.0" prefWidth="647.0" spacing="8.0"
              style="-fx-background-color: -white; -fx-background-radius: 21; -fx-padding: 0 16 0 16;">
            <children>
                <FontIcon iconLiteral="bi-search" iconSize="15" styleClass="icon-muted"/>
                <TextField fx:id="searchField" promptText="Search events, hosts, locations..."
                           style="-fx-background-color: transparent; -fx-border-color: transparent;"
                           onAction="#onSearch" HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
    </children>
</StackPane>