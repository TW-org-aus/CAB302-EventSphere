<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="920.0" prefWidth="1380.0" styleClass="event-page" stylesheets="@app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventsphere.app.EventPageController">
   <children>
      <fx:include source="nav-bar.fxml" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
      <HBox spacing="36.0" style="-fx-padding: 28 40 24 40;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="72.0">
         <children>
            <VBox prefWidth="500.0" spacing="26.0">
               <children>
                  <Button fx:id="backButton" onAction="#onBackClick" styleClass="back-button" text="← Back" />
                  <VBox spacing="14.0" styleClass="event-detail-card">
                     <children>
                        <VBox fx:id="eventFieldsBox" spacing="14.0">
                           <children>
                              <StackPane alignment="CENTER" prefHeight="180.0" styleClass="event-image-frame">
                                 <children>
                                    <ImageView fx:id="eventImage" fitHeight="180.0" fitWidth="464.0" preserveRatio="false" />
                                 </children>
                              </StackPane>
                              <Label fx:id="titleLabel" styleClass="event-title" text="" wrapText="true" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label styleClass="event-meta" text="📅" />
                                    <Label fx:id="dateLabel" styleClass="event-meta" text="" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label styleClass="event-meta" text="🕒" />
                                    <Label fx:id="timeLabel" styleClass="event-meta" text="" />
                                 </children>
                              </HBox>
                              <HBox fx:id="venueRow" alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label styleClass="event-meta" text="📍" />
                                    <Label fx:id="venueLabel" styleClass="event-meta" text="" wrapText="true" />
                                 </children>
                              </HBox>
                              <HBox fx:id="actionBar" alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <ToggleButton fx:id="likeButton" onAction="#onLikeClick" styleClass="action-button" text="♡" />
                                    <ToggleButton fx:id="goingButton" onAction="#onGoingClick" styleClass="action-button" text="Going" />
                                    <Button fx:id="ticketsButton" onAction="#onGetTicketsClick" styleClass="action-button-primary" text="Get tickets" />
                                 </children>
                              </HBox>
                              <Label fx:id="descriptionLabel" styleClass="event-description" text="" wrapText="true" />
                           </children>
                        </VBox>
                        <Label fx:id="notFoundLabel" managed="false" styleClass="event-meta" text="" visible="false" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox maxWidth="Infinity" spacing="14.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="comments-heading" text="Comments" />
                        <StackPane styleClass="comments-count-badge">
                           <children>
                              <Label fx:id="commentsCountLabel" styleClass="comments-count-label" text="" />
                           </children>
                        </StackPane>
                        <Region HBox.hgrow="ALWAYS" />
                        <ToggleButton fx:id="sortTopButton" onAction="#onSortChanged" styleClass="sort-pill" text="Top">
                           <toggleGroup>
                              <ToggleGroup fx:id="sortGroup" />
                           </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="sortNewestButton" onAction="#onSortChanged" selected="true" styleClass="sort-pill" text="Newest" toggleGroup="$sortGroup" />
                     </children>
                  </HBox>
                  <VBox styleClass="composer">
                     <children>
                        <HBox fx:id="replyChip" alignment="CENTER_LEFT" managed="false" spacing="6.0" styleClass="reply-chip" visible="false">
                           <children>
                              <Label fx:id="replyChipLabel" text="" />
                              <Button fx:id="replyChipClose" onAction="#onCancelReplyClick" styleClass="close-button" text="✕" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <TextField fx:id="commentInput" promptText="Write a comment....." HBox.hgrow="ALWAYS" />
                              <Button fx:id="postButton" onAction="#onPostCommentClick" styleClass="action-button-primary" text="Post" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <ScrollPane fitToWidth="true" styleClass="comments-scroll" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="commentsList" spacing="16.0" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
