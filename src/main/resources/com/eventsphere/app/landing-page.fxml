<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.Tooltip?>
<StackPane fx:id="rootPane" prefHeight="800" prefWidth="1280" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventsphere.app.LandingPageController">

    <BorderPane>
        <top>
            <fx:include source="nav-bar.fxml"/>
        </top>
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" BorderPane.alignment="CENTER">
                <content>
                    <VBox>
                        <children>
                            <StackPane fx:id="heroPane" prefHeight="400.0" maxHeight="400.0" VBox.vgrow="NEVER">
                                <ImageView fx:id="heroImage" fitHeight="400.0" preserveRatio="false"/>

                                <Region styleClass="hero-scrim"/>

                                <VBox spacing="8.0" maxWidth="700" StackPane.alignment="BOTTOM_LEFT">
                                    <padding><Insets bottom="60.0" left="48.0"/></padding>
                                    <Label text="FEATURED" styleClass="hero-kicker"/>
                                    <Label fx:id="heroTitle" text="BOILER ROOM" styleClass="hero-title"/>
                                    <Label fx:id="heroBlurb" text="Event description goes here." wrapText="true" styleClass="hero-blurb"/>
                                    <Button text="MORE INFO" onAction="#onMoreInfoClick" styleClass="hero-button"/>
                                </VBox>

                                <HBox fx:id="heroNav" spacing="12.0" alignment="CENTER" maxHeight="40" StackPane.alignment="BOTTOM_CENTER">
                                    <Button onAction="#onPrevHero" styleClass="hero-nav-button">
                                        <graphic><FontIcon iconLiteral="bi-chevron-left" styleClass="icon-white"/></graphic>
                                    </Button>
                                    <Button onAction="#onNextHero" styleClass="hero-nav-button">
                                        <graphic><FontIcon iconLiteral="bi-chevron-right" styleClass="icon-white"/></graphic>
                                    </Button>
                                </HBox>
                            </StackPane>

                            <HBox alignment="CENTER" spacing="16.0" prefHeight="120.0" maxHeight="120.0" styleClass="page-bg">
                                <Button text="EXPLORE" userData="ALL" onAction="#onCategoryFilter" styleClass="category-button"/>
                                <Button text="THIS WEEKEND" userData="WEEKEND" onAction="#onCategoryFilter" styleClass="category-button"/>
                                <Button text="MUSIC" userData="Music" onAction="#onCategoryFilter" styleClass="category-button"/>
                                <Button text="ARTS" userData="Arts &amp; Theatre" onAction="#onCategoryFilter" styleClass="category-button"/>
                                <Button text="FAMILY" userData="Family" onAction="#onCategoryFilter" styleClass="category-button"/>
                                <Button text="SPORT" userData="Sports" onAction="#onCategoryFilter" styleClass="category-button"/>
                                <Button text="FILM" userData="Film" onAction="#onCategoryFilter" styleClass="category-button"/>
                                <Button text="OTHER" userData="Other" onAction="#onCategoryFilter" styleClass="category-button"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="16.0" styleClass="page-bg">
                                <padding><Insets bottom="8.0"/></padding>
                                <ComboBox fx:id="dateFilter" onAction="#onFiltersChanged" prefWidth="180.0" styleClass="filter-combo"/>
                                <ComboBox fx:id="distanceFilter" onAction="#onFiltersChanged" prefWidth="180.0" styleClass="filter-combo"/>
                            </HBox>

                            <VBox fx:id="sectionsBox" spacing="36.0" minWidth="0">
                                <padding><Insets top="32.0" right="48.0" bottom="48.0" left="48.0"/></padding>
                            </VBox>
                        </children>
                    </VBox>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>

    <HBox fx:id="drawer" alignment="CENTER" pickOnBounds="false"
          StackPane.alignment="CENTER_RIGHT">
        <StackPane fx:id="mapPanel" HBox.hgrow="ALWAYS" style="-fx-background-color: #e8e8e8;">
            <Label text="Map goes here" style="-fx-text-fill: #888888;"/>
        </StackPane>
    </HBox>

    <VBox fx:id="detailsPanel" prefWidth="420.0" maxWidth="420.0" spacing="12.0"
          StackPane.alignment="CENTER_LEFT"
          style="-fx-background-color: -white; -fx-border-color: -border; -fx-border-width: 0 1 0 0;">
        <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
        <Label text="Event details" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </VBox>

    <Button fx:id="drawerTab" prefWidth="56.0" maxWidth="56.0"
            onAction="#onToggleDrawer"
            styleClass="map-tab" StackPane.alignment="CENTER_RIGHT">
        <graphic><FontIcon fx:id="drawerTabIcon" iconLiteral="bi-map" iconSize="22"/></graphic>
        <tooltip><Tooltip text="Map"/></tooltip>
    </Button>

</StackPane>