<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eventsphere.app.MessagesController"
            stylesheets="@app.css">
    <content>
        <VBox styleClass="page-bg" alignment="TOP_CENTER" spacing="24">
            <padding>
                <Insets top="40.0" bottom="80.0" left="32.0" right="32.0"/>
            </padding>

            <HBox maxWidth="700">
                <Button text="&#8592; Back" styleClass="secondary-button" onAction="#onBackClick"/>
            </HBox>

            <VBox styleClass="card" maxWidth="700" spacing="18">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="JL" styleClass="avatar"/>
                    <Label text="Jordan Lee" styleClass="card-title"/>
                </HBox>

                <VBox spacing="10">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="See you at the warehouse show!" styleClass="body-text" wrapText="true"/>
                            <Label text="Jordan Lee · 6:41 PM" styleClass="muted-text"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT">
                        <VBox spacing="2" alignment="TOP_RIGHT">
                            <Label text="Can't wait, meet you at the door?" styleClass="body-text" wrapText="true"/>
                            <Label text="You · 6:43 PM" styleClass="muted-text"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Yep, 8pm sharp" styleClass="body-text" wrapText="true"/>
                            <Label text="Jordan Lee · 6:44 PM" styleClass="muted-text"/>
                        </VBox>
                    </HBox>
                </VBox>

                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="messageInput" promptText="Type a message..." HBox.hgrow="ALWAYS"/>
                    <Button text="Send" styleClass="primary-button" onAction="#onSendClick"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
