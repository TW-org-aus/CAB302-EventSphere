<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eventsphere.app.MessagesController"
      stylesheets="@app.css">
    <children>
        <fx:include source="nav-bar.fxml"/>
        <ScrollPane fx:id="scroll" fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
    <content>
        <VBox styleClass="page-bg" alignment="TOP_CENTER" spacing="24">
            <padding>
                <Insets top="40.0" bottom="80.0" left="32.0" right="32.0"/>
            </padding>

            <HBox maxWidth="700">
                <Button text="&#8592; Back" styleClass="secondary-button" onAction="#onBackClick"/>
            </HBox>

            <VBox styleClass="card" maxWidth="700" spacing="18">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label fx:id="avatarLabel" styleClass="avatar"/>
                    <Label fx:id="nameLabel" styleClass="card-title"/>
                </HBox>

                <VBox fx:id="messageList" spacing="10"/>

                <Label fx:id="sendError" styleClass="comment-error" visible="false"/>
                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="messageInput" promptText="Type a message..." HBox.hgrow="ALWAYS" onAction="#onSendClick"/>
                    <Button text="Send" styleClass="primary-button" onAction="#onSendClick"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
        </ScrollPane>
    </children>
</VBox>
