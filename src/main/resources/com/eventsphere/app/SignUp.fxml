<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="730.0" prefWidth="1200.0" style="-fx-background-color: #F0512B;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventsphere.app.SignUpController">
   <children>
      <fx:include source="nav-bar.fxml" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="72.0">
         <children>
            <VBox alignment="CENTER" maxHeight="640.0" maxWidth="460.0" prefHeight="640.0" prefWidth="460.0" style="-fx-background-color: white; -fx-background-radius: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 18, 0.2, 0, 6);">
               <children>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox spacing="14.0" style="-fx-background-color: white; -fx-padding: 32 40 36 40;">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="14.0">
                                 <children>
                                    <Label style="-fx-font-size: 20px; -fx-text-fill: #111111;" text="←" />
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="Create your account" />
                                 </children>
                              </HBox>
                              <Region prefHeight="6.0" />
                              <HBox spacing="12.0">
                                 <children>
                                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="First name">
                                             <font>
                                                <Font size="18.0" />
                                             </font></Label>
                                          <TextField fx:id="firstNameField" maxWidth="Infinity" style="-fx-background-color: #F7F7F7; -fx-background-radius: 8px; -fx-border-color: #E4E4E4; -fx-border-radius: 8px; -fx-padding: 10 12 10 12;" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Last name">
                                             <font>
                                                <Font size="18.0" />
                                             </font></Label>
                                          <TextField fx:id="lastNameField" maxWidth="Infinity" style="-fx-background-color: #F7F7F7; -fx-background-radius: 8px; -fx-border-color: #E4E4E4; -fx-border-radius: 8px; -fx-padding: 10 12 10 12;" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Email">
                                 <font>
                                    <Font size="18.0" />
                                 </font></Label>
                              <TextField fx:id="emailField" maxWidth="Infinity" style="-fx-background-color: #F7F7F7; -fx-background-radius: 8px; -fx-border-color: #E4E4E4; -fx-border-radius: 8px; -fx-padding: 10 12 10 12;" />
                              <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Username">
                                 <font>
                                    <Font size="18.0" />
                                 </font></Label>
                              <TextField fx:id="usernameField" maxWidth="Infinity" style="-fx-background-color: #F7F7F7; -fx-background-radius: 8px; -fx-border-color: #E4E4E4; -fx-border-radius: 8px; -fx-padding: 10 12 10 12;" />
                              <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Password">
                                 <font>
                                    <Font size="18.0" />
                                 </font></Label>
                              <PasswordField fx:id="passwordField" maxWidth="Infinity" style="-fx-background-color: #F7F7F7; -fx-background-radius: 8px; -fx-border-color: #E4E4E4; -fx-border-radius: 8px; -fx-padding: 10 12 10 12;" />

                              <Region prefHeight="4.0" />
                              <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="Where do you live?">
                                 <font>
                                    <Font size="18.0" />
                                 </font></Label>
                              <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" text="So we can find events closer to you" wrapText="true" />
                              <TextField fx:id="cityField" maxWidth="Infinity" promptText="e.g. Brisbane" style="-fx-background-color: #F7F7F7; -fx-background-radius: 8px; -fx-border-color: #E4E4E4; -fx-border-radius: 8px; -fx-padding: 10 12 10 12;" />

                              <Region prefHeight="4.0" />
                              <Label style="-fx-font-size: 14; -fx-text-fill: #333333;" text="What are you into?">
                                 <font>
                                    <Font size="18.0" />
                                 </font></Label>
                              <Label fx:id="interestsHintLabel" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" text="Pick up to 5 categories" wrapText="true" />
                              <FlowPane fx:id="interestsFlowPane" hgap="8.0" vgap="8.0" />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
                  <VBox spacing="14.0" style="-fx-background-color: white; -fx-padding: 12 40 32 40; -fx-background-radius: 0 0 20 20;">
                     <children>
                        <Button onAction="#onSignUpClick" maxWidth="Infinity" prefHeight="40.0" style="-fx-background-color: #2E6BE8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8px;" text="Sign UP" />
                        <Hyperlink onAction="#onLoginClick" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 13px;" text="Login" />
                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Region maxHeight="-Infinity" prefHeight="1.0" style="-fx-background-color: #E2E2E2;" HBox.hgrow="ALWAYS" />
                              <Label style="-fx-text-fill: #999999; -fx-font-size: 11px;" text="or continue with" />
                              <Region maxHeight="-Infinity" prefHeight="1.0" style="-fx-background-color: #E2E2E2;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="18.0">
                           <children>
                              <Button onAction="#onFacebookClick" alignment="CENTER" contentDisplay="CENTER" maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" style="-fx-background-color: #EAF1FD; -fx-text-fill: #1877F2; -fx-background-radius: 50px; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0;" text="f" />
                              <Button onAction="#onInstagramClick" alignment="CENTER" contentDisplay="CENTER" maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" style="-fx-background-color: #EAF1FD; -fx-text-fill: #C13584; -fx-background-radius: 50px; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0;" text="◉" />
                              <Button onAction="#onGoogleClick" alignment="CENTER" contentDisplay="CENTER" maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" style="-fx-background-color: #EAF1FD; -fx-text-fill: #4285F4; -fx-background-radius: 50px; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0;" text="G" />
                              <Button onAction="#onTikTokClick" alignment="CENTER" contentDisplay="CENTER" maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" style="-fx-background-color: #EAF1FD; -fx-text-fill: #111111; -fx-background-radius: 50px; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0;" text="♪" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
