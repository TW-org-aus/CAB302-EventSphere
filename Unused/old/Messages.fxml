<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@styles.css"
            prefWidth="1440.0" prefHeight="900.0">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="24.0">
            <padding>
                <Insets top="14.0" right="32.0" bottom="14.0" left="32.0"/>
            </padding>

            <Label text="EVENTSPHERE" styleClass="logo"/>

            <HBox styleClass="search" alignment="CENTER_LEFT" spacing="12.0"
                  maxWidth="640.0" HBox.hgrow="ALWAYS">
                <SVGPath styleClass="icon-muted"
                         content="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM16.6 16.6l1.4-1.4 5 5-1.4 1.4z"/>
                <TextField promptText="Search events, hosts, locations..."
                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <SVGPath styleClass="icon-dark" content="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/>
            </HBox>

            <HBox alignment="CENTER" spacing="14.0">
                <StackPane styleClass="icon-button">
                    <SVGPath styleClass="icon-dark"
                             content="M12 2a6 6 0 0 0-6 6v4l-2 3v1h16v-1l-2-3V8a6 6 0 0 0-6-6zm0 20a3 3 0 0 0 3-3H9a3 3 0 0 0 3 3z"/>
                    <Circle radius="3.5" styleClass="badge-dot"/>
                </StackPane>

                <StackPane styleClass="icon-button">
                    <SVGPath styleClass="icon-dark"
                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                </StackPane>

                <StackPane styleClass="icon-button, icon-button-accent">
                    <SVGPath styleClass="icon-white"
                             content="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5z"/>
                </StackPane>
            </HBox>
        </HBox>
    </top>

    <!-- ================= MAIN CARD ================= -->
    <center>
        <StackPane styleClass="page-padding">
            <HBox styleClass="card" maxWidth="1180.0">

                <!-- Conversation list -->
                <VBox styleClass="conversations" prefWidth="340.0" minWidth="340.0">

                    <HBox styleClass="conv-search" alignment="CENTER_LEFT" spacing="10.0">
                        <VBox.margin>
                            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                        </VBox.margin>
                        <SVGPath styleClass="icon-muted" scaleX="0.8" scaleY="0.8"
                                 content="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM16.6 16.6l1.4-1.4 5 5-1.4 1.4z"/>
                        <TextField promptText="Search" styleClass="conv-search-field" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox>

                            <HBox styleClass="conversation" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="avatar">
                                    <SVGPath styleClass="icon-blue" scaleX="0.75" scaleY="0.75"
                                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <Label text="User 502" styleClass="conv-name"/>
                                    <Label text="Lorem ipsum dolor sit amet, consectetur ad..."
                                           styleClass="conv-preview" maxWidth="240.0"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="conversation" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="avatar">
                                    <SVGPath styleClass="icon-blue" scaleX="0.75" scaleY="0.75"
                                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <Label text="User 502, User 626" styleClass="conv-name"/>
                                    <Label text="Lorem ipsum dolor sit amet, consectetur ad..."
                                           styleClass="conv-preview" maxWidth="240.0"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="conversation" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="avatar">
                                    <SVGPath styleClass="icon-blue" scaleX="0.75" scaleY="0.75"
                                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <Label text="User 502" styleClass="conv-name"/>
                                    <Label text="Lorem ipsum dolor sit amet, consectetur ad..."
                                           styleClass="conv-preview" maxWidth="240.0"/>
                                </VBox>
                            </HBox>

                            <!-- currently open conversation -->
                            <HBox styleClass="conversation, conversation-active"
                                  alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="avatar">
                                    <SVGPath styleClass="icon-blue" scaleX="0.75" scaleY="0.75"
                                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <Label text="User 565" styleClass="conv-name"/>
                                    <Label text="Sweet, see you then!" styleClass="conv-preview" maxWidth="240.0"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="conversation" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="avatar">
                                    <SVGPath styleClass="icon-blue" scaleX="0.75" scaleY="0.75"
                                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <Label text="User 502" styleClass="conv-name"/>
                                    <Label text="Lorem ipsum dolor sit amet, consectetur ad..."
                                           styleClass="conv-preview" maxWidth="240.0"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="conversation" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="avatar">
                                    <SVGPath styleClass="icon-blue" scaleX="0.75" scaleY="0.75"
                                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <Label text="User 502" styleClass="conv-name"/>
                                    <Label text="Lorem ipsum dolor sit amet, consectetur ad..."
                                           styleClass="conv-preview" maxWidth="240.0"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="conversation" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="avatar">
                                    <SVGPath styleClass="icon-blue" scaleX="0.75" scaleY="0.75"
                                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <Label text="User 626" styleClass="conv-name"/>
                                    <Label text="Lorem ipsum dolor sit amet, consectetur ad..."
                                           styleClass="conv-preview" maxWidth="240.0"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="conversation" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="avatar">
                                    <SVGPath styleClass="icon-blue" scaleX="0.75" scaleY="0.75"
                                             content="M12 3C6.9 3 3 6.4 3 10.5c0 2.2 1.1 4.1 2.9 5.4L5 21l4.6-2.3c.8.2 1.6.3 2.4.3 5.1 0 9-3.4 9-7.5S17.1 3 12 3z"/>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <Label text="User 502, User 626" styleClass="conv-name"/>
                                    <Label text="Lorem ipsum dolor sit amet, consectetur ad..."
                                           styleClass="conv-preview" maxWidth="240.0"/>
                                </VBox>
                            </HBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

                <!-- Chat panel -->
                <VBox HBox.hgrow="ALWAYS">

                    <VBox styleClass="chat-header" alignment="CENTER" spacing="4.0">
                        <Label text="User 565" styleClass="chat-name"/>
                        <Label text="Last online: 5m ago" styleClass="chat-sub"/>
                    </VBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                        <VBox styleClass="thread" spacing="6.0" minHeight="560.0">

                            <HBox alignment="CENTER_RIGHT">
                                <Label text="We heading out tonight?" styleClass="bubble, sent"/>
                            </HBox>
                            <HBox alignment="CENTER_RIGHT">
                                <Label text="Seen 5m ago" styleClass="receipt"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Yeah" styleClass="bubble, received"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="I'll meet you outside at 6" styleClass="bubble, received-dark"/>
                            </HBox>

                            <HBox alignment="CENTER_RIGHT">
                                <VBox.margin>
                                    <Insets top="40.0"/>
                                </VBox.margin>
                                <Label text="Sweet, see you then!" styleClass="bubble, sent-latest"/>
                            </HBox>
                            <HBox alignment="CENTER_RIGHT">
                                <Label text="Sent 3m ago" styleClass="receipt"/>
                            </HBox>

                        </VBox>
                    </ScrollPane>

                    <HBox styleClass="composer" alignment="CENTER" spacing="14.0">
                        <Button text="+" styleClass="add-button"/>
                        <HBox styleClass="composer-field-box" alignment="CENTER_LEFT"
                              spacing="10.0" HBox.hgrow="ALWAYS">
                            <TextField promptText="Send a message" styleClass="composer-field" HBox.hgrow="ALWAYS"/>
                            <SVGPath styleClass="icon-dark" scaleX="0.85" scaleY="0.85"
                                     content="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0h-2a5 5 0 0 1-10 0zm6 8h2v3h-2z"/>
                        </HBox>
                    </HBox>
                </VBox>

            </HBox>
        </StackPane>
    </center>

</BorderPane>
